<?xml version="1.0" encoding="utf-8"?>
<!--
  小组件二：鼓励语。
  w_root 可点 → 换下一条语句（本地轮换，不开 App）。
  左侧 w_quote_mark 是强调色短竖条。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="34dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/w_quote_mark"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="10dp"
            android:src="@drawable/widget_quote_mark"
            android:scaleType="fitXY"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="3"
                android:ellipsize="end"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp"
                android:text="打开学习 OS 同步一次" />

            <TextView
                android:id="@+id/w_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:textSize="10sp"
                android:text="" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/w_theme"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:padding="12dp">

        <ImageView
            android:id="@+id/w_theme_dot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_dot"
            android:contentDescription="切换主题" />
    </FrameLayout>
</FrameLayout>
